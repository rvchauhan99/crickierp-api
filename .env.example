# Copy to `.env` for local — Node only loads `.env`, not this file.
# Production (addacrm VPS): do not commit this file. Put each key in GitHub
# Environment "production" (Secrets vs Variables). Then run workflow "Sync env"
# to change one value — do not paste a full env blob.
# REDIS_URL is injected by docker-compose as redis://redis:6379; do not store it
# in GitHub. Optional helper: ./deploy/push-github-env.sh
# VPS public host (GitHub Environment variable PUBLIC_API_HOST):
# PUBLIC_API_HOST=addacrm.178.92.120.191.sslip.io
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/crickierp
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
# Comma-separated allowlist (spaces optional): all listed origins are allowed.
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Email (optional)
BREVO_USER=
BREVO_MASTER_KEY=
BREVO_FROM=noreply@crickierp.local

# Bucket storage (required for document uploads)
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
BUCKET_PUBLIC_URL_BASE=

# Mongo performance tuning
MONGO_MAX_POOL_SIZE=80
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_CONNECTING=8
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Observability and performance gates
ENABLE_MONGO_SLOW_QUERY_LOG=true
MONGO_SLOW_QUERY_MS=120
ENABLE_PERFORMANCE_METRICS=true
API_P95_WARN_MS=500

# Redis (required to enable cache and BullMQ queue workers)
REDIS_URL=rediss://default:<upstash-token>@<upstash-host>:6379

# Currency — default fixed INR with conversion off.
# Multi-currency clients (e.g. addacrm) must set CURRENCY_CONVERSION_ENABLED=true
# in GitHub Environment production (and sync/deploy). PLATFORM_CURRENCY seeds the
# ledger when PlatformSettings has no currency yet; it does not unlock/change a locked DB value.
PLATFORM_CURRENCY=INR
CURRENCY_CONVERSION_ENABLED=false

# Liability persons / person settlement. Default true.
# Bank-only deploys set LIABILITY_MODULE_ENABLED=false (hides liability module;
# deposit/withdrawal/expense settle via bank only; bank transfers still work).
LIABILITY_MODULE_ENABLED=true
